{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "werun-community/timeline",
  "version": "1.0.0",
  "title": "Timeline",
  "category": "werun-community",
  "icon": "backup",
  "description": "Company history or a process, step by step: vertical, alternating sides or a horizontal track you scroll, with dots, icons, numbers or years on the line.",
  "keywords": [
    "timeline",
    "history",
    "milestones",
    "process",
    "steps",
    "roadmap",
    "years"
  ],
  "textdomain": "werun-blocks-community",
  "allowedBlocks": [
    "werun-community/timeline-item"
  ],
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    },
    "showHeader": {
      "type": "boolean",
      "default": false
    },
    "showEyebrow": {
      "type": "boolean",
      "default": true
    },
    "showIntro": {
      "type": "boolean",
      "default": true
    },
    "eyebrow": {
      "type": "string",
      "role": "content",
      "default": "Our story"
    },
    "title": {
      "type": "string",
      "role": "content",
      "default": "How we got here"
    },
    "intro": {
      "type": "string",
      "role": "content",
      "default": "The moments that shaped the company, year by year."
    },
    "headerAlign": {
      "type": "string",
      "default": "left"
    },
    "titleLevel": {
      "type": "number",
      "default": 2
    },
    "orientation": {
      "type": "string",
      "default": "vertical",
      "enum": [
        "vertical",
        "alternating",
        "horizontal"
      ]
    },
    "alternateStart": {
      "type": "string",
      "default": "end",
      "enum": [
        "start",
        "end"
      ]
    },
    "itemWidth": {
      "type": "number",
      "default": 300
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "gap": {
      "type": "number",
      "default": 32
    },
    "lineStyle": {
      "type": "string",
      "default": "solid",
      "enum": [
        "solid",
        "dashed",
        "dotted",
        "none"
      ]
    },
    "lineWidth": {
      "type": "number",
      "default": 2
    },
    "lineColor": {
      "type": "string"
    },
    "markerStyle": {
      "type": "string",
      "default": "dot",
      "enum": [
        "dot",
        "icon",
        "number",
        "year"
      ]
    },
    "markerIcon": {
      "type": "object",
      "default": {
        "name": "circle-check",
        "lib": "lucide",
        "anim": "none",
        "trigger": "hover"
      }
    },
    "iconSize": {
      "type": "number",
      "default": 18
    },
    "iconStroke": {
      "type": "number",
      "default": 2
    },
    "markerColor": {
      "type": "string"
    },
    "markerTextColor": {
      "type": "string"
    },
    "datePosition": {
      "type": "string",
      "default": "card",
      "enum": [
        "card",
        "opposite"
      ]
    },
    "cardStyle": {
      "type": "string",
      "default": "bordered",
      "enum": [
        "plain",
        "bordered",
        "filled",
        "shadow"
      ]
    },
    "cardBg": {
      "type": "string"
    },
    "cardBorderColor": {
      "type": "string"
    },
    "cardRadius": {
      "type": "number",
      "default": 14
    },
    "cardPadding": {
      "type": "number",
      "default": 24
    },
    "showImages": {
      "type": "boolean",
      "default": true
    },
    "itemTitleLevel": {
      "type": "number",
      "default": 3
    },
    "accentColor": {
      "type": "string"
    },
    "reveal": {
      "type": "boolean",
      "default": true
    }
  },
  "providesContext": {
    "werun-community/timeline/orientation": "orientation",
    "werun-community/timeline/markerStyle": "markerStyle",
    "werun-community/timeline/markerIcon": "markerIcon",
    "werun-community/timeline/datePosition": "datePosition",
    "werun-community/timeline/showImages": "showImages",
    "werun-community/timeline/itemTitleLevel": "itemTitleLevel",
    "werun-community/timeline/reveal": "reveal",
    "werun-community/timeline/showHeader": "showHeader",
    "werun-community/timeline/title": "title",
    "werun-community/timeline/titleLevel": "titleLevel",
    "werun-community/timeline/cardStyle": "cardStyle",
    "werun-community/timeline/cardBg": "cardBg",
    "werun-community/timeline/accentColor": "accentColor",
    "werun-community/timeline/textColor": "textColor",
    "werun-community/timeline/style": "style"
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "color": {
      "background": true,
      "text": true,
      "gradients": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [
    "wrbc-shared",
    "file:./style-index.css"
  ],
  "viewScript": [
    "wrbc-shared-view",
    "file:./view.js"
  ],
  "render": "file:./render.php"
}