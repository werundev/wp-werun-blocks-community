{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "werun-community/hero",
  "version": "1.0.0",
  "title": "Hero",
  "category": "werun-community",
  "icon": "cover-image",
  "description": "Opening section: eyebrow, heading, text, checklist, two buttons, figures and an image, each one optional. Split or centred, over a background image or a muted looping video.",
  "keywords": [
    "hero",
    "header",
    "banner",
    "cta",
    "landing"
  ],
  "textdomain": "werun-blocks-community",
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "layout": {
      "type": "string",
      "default": "split",
      "enum": [
        "split",
        "centered"
      ]
    },
    "mediaPosition": {
      "type": "string",
      "default": "right",
      "enum": [
        "right",
        "left"
      ]
    },
    "mobileMediaFirst": {
      "type": "boolean",
      "default": false
    },
    "splitRatio": {
      "type": "number",
      "default": 55
    },
    "verticalAlign": {
      "type": "string",
      "default": "center",
      "enum": [
        "start",
        "center",
        "end"
      ]
    },
    "contentWidth": {
      "type": "number",
      "default": 1200
    },
    "minHeight": {
      "type": "number",
      "default": 0
    },
    "minHeightUnit": {
      "type": "string",
      "default": "vh",
      "enum": [
        "vh",
        "px"
      ]
    },
    "showEyebrow": {
      "type": "boolean",
      "default": true
    },
    "eyebrowStyle": {
      "type": "string",
      "default": "pill",
      "enum": [
        "pill",
        "plain"
      ]
    },
    "eyebrow": {
      "type": "string",
      "role": "content",
      "default": "New for 2026"
    },
    "eyebrowIcon": {
      "type": "object",
      "default": {
        "name": "sparkles",
        "lib": "animated",
        "anim": "auto",
        "trigger": "inview"
      }
    },
    "heading": {
      "type": "string",
      "role": "content",
      "default": "A website that works as hard as your team"
    },
    "headingLevel": {
      "type": "number",
      "default": 1
    },
    "showText": {
      "type": "boolean",
      "default": true
    },
    "text": {
      "type": "string",
      "role": "content",
      "default": "Say what you do, who it is for and why it matters in two lines. Everything in this section can be edited, restyled or switched off."
    },
    "showPoints": {
      "type": "boolean",
      "default": true
    },
    "pointsIcon": {
      "type": "object",
      "default": {
        "name": "circle-check",
        "lib": "lucide",
        "anim": "draw",
        "trigger": "inview"
      }
    },
    "points": {
      "type": "array",
      "role": "content",
      "default": [
        {
          "text": "Set up in a week"
        },
        {
          "text": "No long contracts"
        },
        {
          "text": "Support in your language"
        }
      ]
    },
    "showPrimary": {
      "type": "boolean",
      "default": true
    },
    "primaryLabel": {
      "type": "string",
      "role": "content",
      "default": "Get started"
    },
    "primaryUrl": {
      "type": "string",
      "role": "content",
      "default": "#"
    },
    "primaryNewTab": {
      "type": "boolean",
      "default": false
    },
    "primaryIcon": {
      "type": "object",
      "default": {
        "name": "arrow-right",
        "lib": "animated",
        "anim": "auto",
        "trigger": "hover"
      }
    },
    "showSecondary": {
      "type": "boolean",
      "default": true
    },
    "secondaryLabel": {
      "type": "string",
      "role": "content",
      "default": "See how it works"
    },
    "secondaryUrl": {
      "type": "string",
      "role": "content",
      "default": "#"
    },
    "secondaryNewTab": {
      "type": "boolean",
      "default": false
    },
    "secondaryIcon": {
      "type": "object",
      "default": {
        "name": "circle-play",
        "lib": "lucide",
        "anim": "pop",
        "trigger": "hover"
      }
    },
    "buttonShape": {
      "type": "string",
      "default": "pill",
      "enum": [
        "pill",
        "rounded",
        "square"
      ]
    },
    "showStats": {
      "type": "boolean",
      "default": false
    },
    "stats": {
      "type": "array",
      "role": "content",
      "default": [
        {
          "value": "120+",
          "label": "Projects shipped"
        },
        {
          "value": "4.9",
          "label": "Average rating"
        },
        {
          "value": "24 h",
          "label": "Reply time"
        }
      ]
    },
    "showMedia": {
      "type": "boolean",
      "default": true
    },
    "mediaId": {
      "type": "number",
      "role": "content"
    },
    "mediaUrl": {
      "type": "string",
      "role": "content"
    },
    "mediaAlt": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "mediaRatio": {
      "type": "string",
      "default": "4/3"
    },
    "mediaFit": {
      "type": "string",
      "default": "cover",
      "enum": [
        "cover",
        "contain"
      ]
    },
    "bgImageId": {
      "type": "number",
      "role": "content"
    },
    "bgImageUrl": {
      "type": "string",
      "role": "content"
    },
    "bgVideoId": {
      "type": "number",
      "role": "content"
    },
    "bgVideoUrl": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "bgVideoPosterId": {
      "type": "number",
      "role": "content"
    },
    "bgVideoPosterUrl": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "bgVideoControls": {
      "type": "string",
      "default": "bottom-right",
      "enum": [
        "bottom-right",
        "bottom-left",
        "top-right",
        "top-left"
      ]
    },
    "bgVideoMobile": {
      "type": "boolean",
      "default": true
    },
    "overlayColor": {
      "type": "string",
      "default": "#000000"
    },
    "overlayOpacity": {
      "type": "number",
      "default": 55
    },
    "accentColor": {
      "type": "string"
    },
    "onAccentColor": {
      "type": "string"
    },
    "iconSize": {
      "type": "number",
      "default": 18
    },
    "iconStroke": {
      "type": "number",
      "default": 2
    },
    "reveal": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "color": {
      "background": true,
      "text": true,
      "gradients": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "__experimentalBorder": {
      "radius": true,
      "color": true,
      "width": true,
      "style": true
    }
  },
  "example": {
    "attributes": {
      "showStats": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [
    "wrbc-shared",
    "file:./style-index.css"
  ],
  "viewScript": [
    "wrbc-shared-view"
  ],
  "render": "file:./render.php"
}