{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "werun-community/cta",
  "version": "1.0.0",
  "title": "Call to action",
  "category": "werun-community",
  "icon": "megaphone",
  "description": "A banner that asks for one action: eyebrow, title, text, one or two buttons and an optional image. Centred, split, compact strip or floating card.",
  "keywords": [
    "cta",
    "call to action",
    "banner",
    "signup",
    "contact",
    "button"
  ],
  "textdomain": "werun-blocks-community",
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    },
    "layout": {
      "type": "string",
      "default": "centered",
      "enum": [
        "centered",
        "split",
        "strip",
        "card"
      ]
    },
    "contentAlign": {
      "type": "string",
      "default": "center",
      "enum": [
        "left",
        "center"
      ]
    },
    "mediaPosition": {
      "type": "string",
      "default": "right",
      "enum": [
        "left",
        "right"
      ]
    },
    "mobileMediaFirst": {
      "type": "boolean",
      "default": false
    },
    "contentWidth": {
      "type": "number",
      "default": 1100
    },
    "showEyebrow": {
      "type": "boolean",
      "default": true
    },
    "eyebrow": {
      "type": "string",
      "role": "content",
      "default": "Ready when you are"
    },
    "eyebrowIcon": {
      "type": "object",
      "default": {
        "name": "sparkles",
        "lib": "animated",
        "anim": "auto",
        "trigger": "hover"
      }
    },
    "title": {
      "type": "string",
      "role": "content",
      "default": "Let’s build the next version of your website"
    },
    "titleLevel": {
      "type": "number",
      "default": 2
    },
    "showText": {
      "type": "boolean",
      "default": true
    },
    "text": {
      "type": "string",
      "role": "content",
      "default": "Tell us where you want to be in a year. We reply within one working day with a plan and a price."
    },
    "showPrimary": {
      "type": "boolean",
      "default": true
    },
    "primaryLabel": {
      "type": "string",
      "role": "content",
      "default": "Book a call"
    },
    "primaryUrl": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "primaryNewTab": {
      "type": "boolean",
      "default": false
    },
    "primaryIcon": {
      "type": "object",
      "default": {
        "name": "arrow-right",
        "lib": "animated",
        "anim": "auto",
        "trigger": "hover"
      }
    },
    "showSecondary": {
      "type": "boolean",
      "default": true
    },
    "secondaryLabel": {
      "type": "string",
      "role": "content",
      "default": "See our work"
    },
    "secondaryUrl": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "secondaryNewTab": {
      "type": "boolean",
      "default": false
    },
    "secondaryIcon": {
      "type": "object",
      "default": {}
    },
    "buttonShape": {
      "type": "string",
      "default": "pill",
      "enum": [
        "pill",
        "rounded",
        "square"
      ]
    },
    "showMedia": {
      "type": "boolean",
      "default": false
    },
    "mediaId": {
      "type": "number",
      "role": "content"
    },
    "mediaUrl": {
      "type": "string",
      "role": "content"
    },
    "mediaAlt": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "mediaRatio": {
      "type": "string",
      "default": "auto",
      "enum": [
        "auto",
        "1/1",
        "4/3",
        "3/2",
        "16/9",
        "3/4"
      ]
    },
    "bgImageId": {
      "type": "number",
      "role": "content"
    },
    "bgImageUrl": {
      "type": "string",
      "role": "content"
    },
    "overlayColor": {
      "type": "string",
      "default": "#000000"
    },
    "overlayOpacity": {
      "type": "number",
      "default": 55
    },
    "cardBg": {
      "type": "string"
    },
    "cardText": {
      "type": "string"
    },
    "accentColor": {
      "type": "string"
    },
    "onAccentColor": {
      "type": "string"
    },
    "iconSize": {
      "type": "number",
      "default": 18
    },
    "iconStroke": {
      "type": "number",
      "default": 2
    },
    "reveal": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "color": {
      "background": true,
      "text": true,
      "gradients": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "__experimentalBorder": {
      "radius": true,
      "color": true,
      "width": true,
      "style": true
    }
  },
  "example": {
    "attributes": {
      "layout": "centered",
      "primaryUrl": "https://example.com/contact",
      "secondaryUrl": "https://example.com/work"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [
    "wrbc-shared",
    "file:./style-index.css"
  ],
  "viewScript": [
    "wrbc-shared-view"
  ],
  "render": "file:./render.php"
}