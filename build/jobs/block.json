{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "werun-community/jobs",
  "version": "1.0.0",
  "title": "Jobs",
  "category": "werun-community",
  "icon": "id",
  "description": "Open positions from your applicant tracking system (Greenhouse, Lever, Ashby, Workable, SmartRecruiters, Personio, Teamtailor, BambooHR), cached, grouped by department, as cards or a table, with search and filters.",
  "keywords": [
    "jobs",
    "careers",
    "positions",
    "hiring",
    "ats",
    "greenhouse",
    "lever",
    "vacancies"
  ],
  "textdomain": "werun-blocks-community",
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    },
    "provider": {
      "type": "string",
      "role": "content",
      "default": "",
      "enum": [
        "",
        "greenhouse",
        "lever",
        "ashby",
        "workable",
        "smartrecruiters",
        "personio",
        "teamtailor",
        "bamboohr"
      ]
    },
    "board": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "region": {
      "type": "string",
      "role": "content",
      "default": "",
      "enum": [
        "",
        "eu",
        "com"
      ]
    },
    "layout": {
      "type": "string",
      "default": "grouped-list",
      "enum": [
        "grouped-list",
        "cards",
        "table",
        "list"
      ]
    },
    "groupBy": {
      "type": "boolean",
      "default": true
    },
    "columnsDesktop": {
      "type": "number",
      "default": 3
    },
    "columnsTablet": {
      "type": "number",
      "default": 2
    },
    "columnsMobile": {
      "type": "number",
      "default": 1
    },
    "gap": {
      "type": "number",
      "default": 20
    },
    "sort": {
      "type": "string",
      "default": "date",
      "enum": [
        "date",
        "title",
        "department"
      ]
    },
    "maxJobs": {
      "type": "number",
      "default": 0
    },
    "showDepartment": {
      "type": "boolean",
      "default": true
    },
    "showLocation": {
      "type": "boolean",
      "default": true
    },
    "showType": {
      "type": "boolean",
      "default": true
    },
    "showRemote": {
      "type": "boolean",
      "default": true
    },
    "showDate": {
      "type": "boolean",
      "default": false
    },
    "showCompensation": {
      "type": "boolean",
      "default": false
    },
    "showDescription": {
      "type": "boolean",
      "default": false
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "showApply": {
      "type": "boolean",
      "default": true
    },
    "applyLabel": {
      "type": "string",
      "role": "content",
      "default": "Apply"
    },
    "newTab": {
      "type": "boolean",
      "default": false
    },
    "showFilters": {
      "type": "boolean",
      "default": false
    },
    "filterSearch": {
      "type": "boolean",
      "default": true
    },
    "filterDepartment": {
      "type": "boolean",
      "default": true
    },
    "filterLocation": {
      "type": "boolean",
      "default": true
    },
    "filterRemote": {
      "type": "boolean",
      "default": true
    },
    "filterType": {
      "type": "boolean",
      "default": false
    },
    "searchPlaceholder": {
      "type": "string",
      "role": "content",
      "default": "Role, team or city"
    },
    "noResults": {
      "type": "string",
      "role": "content",
      "default": "No position matches those filters."
    },
    "emptyText": {
      "type": "string",
      "role": "content",
      "default": "There are no open positions right now. Check back soon."
    },
    "showHeader": {
      "type": "boolean",
      "default": false
    },
    "showEyebrow": {
      "type": "boolean",
      "default": true
    },
    "showIntro": {
      "type": "boolean",
      "default": true
    },
    "eyebrow": {
      "type": "string",
      "role": "content",
      "default": "Careers"
    },
    "title": {
      "type": "string",
      "role": "content",
      "default": "Open positions"
    },
    "intro": {
      "type": "string",
      "role": "content",
      "default": "Join the team. Every role is open to remote candidates unless it says otherwise."
    },
    "headerAlign": {
      "type": "string",
      "default": "left"
    },
    "titleLevel": {
      "type": "number",
      "default": 2
    },
    "headingLevel": {
      "type": "number",
      "default": 3
    },
    "reveal": {
      "type": "boolean",
      "default": false
    },
    "accentColor": {
      "type": "string"
    },
    "cardBg": {
      "type": "string"
    },
    "radius": {
      "type": "number",
      "default": 12
    }
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "color": {
      "background": true,
      "text": true,
      "gradients": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [
    "wrbc-shared",
    "wrbc-modules",
    "file:./style-index.css"
  ],
  "viewScript": [
    "wrbc-shared-view",
    "wrbc-filter",
    "file:./view.js"
  ],
  "render": "file:./render.php"
}