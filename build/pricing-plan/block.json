{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "werun-community/pricing-plan",
  "version": "1.0.0",
  "title": "Pricing plan",
  "category": "werun-community",
  "icon": "tag",
  "description": "One plan of a pricing table.",
  "parent": [
    "werun-community/pricing"
  ],
  "textdomain": "werun-blocks-community",
  "attributes": {
    "icon": {
      "type": "object",
      "role": "content",
      "default": {
        "name": "rocket",
        "lib": "animated",
        "anim": "auto",
        "trigger": "hover"
      }
    },
    "name": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "description": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "priceMonthly": {
      "type": "string",
      "role": "content",
      "default": "0"
    },
    "priceYearly": {
      "type": "string",
      "role": "content",
      "default": "0"
    },
    "periodMonthly": {
      "type": "string",
      "role": "content",
      "default": "/month"
    },
    "periodYearly": {
      "type": "string",
      "role": "content",
      "default": "/month, billed yearly"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "badge": {
      "type": "string",
      "role": "content",
      "default": "Most popular"
    },
    "features": {
      "type": "array",
      "role": "content",
      "default": []
    },
    "ctaLabel": {
      "type": "string",
      "role": "content",
      "default": "Get started"
    },
    "ctaUrl": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "ctaNewTab": {
      "type": "boolean",
      "default": false
    },
    "note": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "hideIcon": {
      "type": "boolean",
      "default": false
    },
    "hideDescription": {
      "type": "boolean",
      "default": false
    },
    "hideNote": {
      "type": "boolean",
      "default": false
    }
  },
  "usesContext": [
    "werun-community/pricing/currency",
    "werun-community/pricing/currencyPosition",
    "werun-community/pricing/showToggle",
    "werun-community/pricing/defaultPeriod",
    "werun-community/pricing/buttonStyle",
    "werun-community/pricing/showPlanIcon",
    "werun-community/pricing/showDescription",
    "werun-community/pricing/showBadge",
    "werun-community/pricing/showFeatures",
    "werun-community/pricing/showExcluded",
    "werun-community/pricing/showNote",
    "werun-community/pricing/includedIcon",
    "werun-community/pricing/excludedIcon",
    "werun-community/pricing/reveal",
    "werun-community/pricing/showHeader",
    "werun-community/pricing/title",
    "werun-community/pricing/titleLevel",
    "werun-community/pricing/cardStyle",
    "werun-community/pricing/cardBg",
    "werun-community/pricing/featuredBg",
    "werun-community/pricing/accentColor",
    "werun-community/pricing/onAccentColor",
    "werun-community/pricing/textColor",
    "werun-community/pricing/style"
  ],
  "supports": {
    "anchor": true,
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "text": true,
      "link": true
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}