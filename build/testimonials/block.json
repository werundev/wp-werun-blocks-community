{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "werun-community/testimonials",
  "version": "1.0.0",
  "title": "Testimonials",
  "category": "werun-community",
  "icon": "format-quote",
  "description": "Quotes with name, role, photo and rating, written by hand or taken from a post type, as a carousel (arrows, dots, autoplay, keyboard and swipe) or a grid, with slides per screen size.",
  "keywords": [
    "testimonials",
    "reviews",
    "quotes",
    "carousel",
    "slider",
    "clients"
  ],
  "textdomain": "werun-blocks-community",
  "allowedBlocks": [
    "werun-community/testimonial"
  ],
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    },
    "source": {
      "type": "string",
      "role": "content",
      "default": "manual",
      "enum": [
        "manual",
        "query"
      ]
    },
    "query": {
      "type": "object",
      "role": "content",
      "default": {
        "postType": "",
        "mode": "query",
        "orderBy": "date",
        "order": "DESC",
        "perPage": 6,
        "excludeCurrent": true
      }
    },
    "map": {
      "type": "object",
      "role": "content",
      "default": {
        "quote": "excerpt",
        "name": "title",
        "role": "",
        "avatar": "featured",
        "rating": "",
        "words": 40
      }
    },
    "emptyText": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "showHeader": {
      "type": "boolean",
      "default": true
    },
    "showEyebrow": {
      "type": "boolean",
      "default": true
    },
    "showIntro": {
      "type": "boolean",
      "default": false
    },
    "eyebrow": {
      "type": "string",
      "role": "content",
      "default": "Testimonials"
    },
    "title": {
      "type": "string",
      "role": "content",
      "default": "What clients say"
    },
    "intro": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "headerAlign": {
      "type": "string",
      "default": "left"
    },
    "titleLevel": {
      "type": "number",
      "default": 2
    },
    "layout": {
      "type": "string",
      "default": "carousel",
      "enum": [
        "carousel",
        "grid"
      ]
    },
    "columnsDesktop": {
      "type": "number",
      "default": 3
    },
    "columnsTablet": {
      "type": "number",
      "default": 2
    },
    "columnsMobile": {
      "type": "number",
      "default": 1
    },
    "gap": {
      "type": "number",
      "default": 24
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "interval": {
      "type": "number",
      "default": 6
    },
    "loop": {
      "type": "boolean",
      "default": true
    },
    "pauseOnHover": {
      "type": "boolean",
      "default": true
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "showDots": {
      "type": "boolean",
      "default": true
    },
    "controlsPosition": {
      "type": "string",
      "default": "bottom",
      "enum": [
        "bottom",
        "top"
      ]
    },
    "prevIcon": {
      "type": "object",
      "default": {
        "name": "arrow-left",
        "lib": "animated",
        "anim": "auto",
        "trigger": "hover"
      }
    },
    "nextIcon": {
      "type": "object",
      "default": {
        "name": "arrow-right",
        "lib": "animated",
        "anim": "auto",
        "trigger": "hover"
      }
    },
    "cardStyle": {
      "type": "string",
      "default": "bordered",
      "enum": [
        "plain",
        "bordered",
        "filled",
        "shadow"
      ]
    },
    "contentAlign": {
      "type": "string",
      "default": "left",
      "enum": [
        "left",
        "center"
      ]
    },
    "showRating": {
      "type": "boolean",
      "default": true
    },
    "showAvatar": {
      "type": "boolean",
      "default": true
    },
    "showRole": {
      "type": "boolean",
      "default": true
    },
    "showQuoteIcon": {
      "type": "boolean",
      "default": true
    },
    "quoteIcon": {
      "type": "object",
      "default": {
        "name": "quote",
        "lib": "lucide",
        "anim": "pop",
        "trigger": "inview"
      }
    },
    "accentColor": {
      "type": "string"
    },
    "starColor": {
      "type": "string"
    },
    "cardBg": {
      "type": "string"
    },
    "cardBorderColor": {
      "type": "string"
    },
    "cardRadius": {
      "type": "number",
      "default": 18
    },
    "iconSize": {
      "type": "number",
      "default": 20
    },
    "iconStroke": {
      "type": "number",
      "default": 2
    },
    "reveal": {
      "type": "boolean",
      "default": true
    }
  },
  "usesContext": [
    "postId"
  ],
  "providesContext": {
    "werun-community/testimonials/showRating": "showRating",
    "werun-community/testimonials/showAvatar": "showAvatar",
    "werun-community/testimonials/showRole": "showRole",
    "werun-community/testimonials/showQuoteIcon": "showQuoteIcon",
    "werun-community/testimonials/quoteIcon": "quoteIcon",
    "werun-community/testimonials/layout": "layout",
    "werun-community/testimonials/reveal": "reveal",
    "werun-community/testimonials/cardStyle": "cardStyle",
    "werun-community/testimonials/cardBg": "cardBg",
    "werun-community/testimonials/starColor": "starColor",
    "werun-community/testimonials/accentColor": "accentColor"
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "color": {
      "background": true,
      "text": true,
      "gradients": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [
    "wrbc-shared",
    "wrbc-modules",
    "file:./style-index.css"
  ],
  "viewScript": [
    "wrbc-shared-view",
    "wrbc-carousel"
  ],
  "render": "file:./render.php"
}