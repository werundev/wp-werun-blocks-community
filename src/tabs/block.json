{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "werun-community/tabs",
	"version": "1.0.0",
	"title": "Tabs",
	"category": "werun-community",
	"icon": "index-card",
	"description": "Content in tabs: horizontal or vertical, four styles, optional icons, links to a tab, and tabs that become an accordion on narrow screens. Every panel holds any blocks.",
	"keywords": [ "tabs", "tabbed", "panels", "switcher", "toggle" ],
	"textdomain": "werun-blocks-community",
	"allowedBlocks": [ "werun-community/tab" ],
	"attributes": {
		"align": { "type": "string", "default": "wide" },
		"showHeader": { "type": "boolean", "default": false },
		"showEyebrow": { "type": "boolean", "default": true },
		"showIntro": { "type": "boolean", "default": true },
		"eyebrow": { "type": "string", "role": "content", "default": "How it works" },
		"title": { "type": "string", "role": "content", "default": "Everything in one place" },
		"intro": { "type": "string", "role": "content", "default": "Pick a tab to see the details." },
		"headerAlign": { "type": "string", "default": "left" },
		"titleLevel": { "type": "number", "default": 2 },
		"orientation": { "type": "string", "default": "horizontal", "enum": [ "horizontal", "vertical" ] },
		"tabStyle": { "type": "string", "default": "underline", "enum": [ "underline", "pills", "boxed", "segmented" ] },
		"tabAlign": { "type": "string", "default": "start", "enum": [ "start", "center", "end" ] },
		"fullWidth": { "type": "boolean", "default": false },
		"navWidth": { "type": "number", "default": 240 },
		"activation": { "type": "string", "default": "auto", "enum": [ "auto", "manual" ] },
		"deepLinks": { "type": "boolean", "default": true },
		"showIcons": { "type": "boolean", "default": false },
		"tabIcon": { "type": "object", "default": { "name": "sparkles", "lib": "lucide", "anim": "none", "trigger": "hover" } },
		"iconPosition": { "type": "string", "default": "start", "enum": [ "start", "top", "end" ] },
		"iconSize": { "type": "number", "default": 18 },
		"iconStroke": { "type": "number", "default": 2 },
		"mobileMode": { "type": "string", "default": "scroll", "enum": [ "scroll", "accordion" ] },
		"accordionBelow": { "type": "number", "default": 600 },
		"accentColor": { "type": "string" },
		"radius": { "type": "number", "default": 10 },
		"reveal": { "type": "boolean", "default": true }
	},
	"providesContext": {
		"werun-community/tabs/showIcons": "showIcons",
		"werun-community/tabs/tabIcon": "tabIcon",
		"werun-community/tabs/showHeader": "showHeader",
		"werun-community/tabs/titleLevel": "titleLevel",
		"werun-community/tabs/accentColor": "accentColor"
	},
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"html": false,
		"color": { "background": true, "text": true, "gradients": true, "link": true },
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": [ "wrbc-shared", "wrbc-modules", "file:./style-index.css" ],
	"viewScript": [ "wrbc-shared-view", "wrbc-tabs" ],
	"render": "file:./render.php"
}
