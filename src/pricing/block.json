{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "werun-community/pricing",
	"version": "1.0.0",
	"title": "Pricing table",
	"category": "werun-community",
	"icon": "money-alt",
	"description": "Plans with a monthly / yearly switch that works, a highlighted plan, feature lists with included and excluded lines, and columns per screen size.",
	"keywords": [ "pricing", "plans", "price", "table", "subscription", "packages" ],
	"textdomain": "werun-blocks-community",
	"allowedBlocks": [ "werun-community/pricing-plan" ],
	"attributes": {
		"align": { "type": "string", "default": "wide" },
		"showHeader": { "type": "boolean", "default": true },
		"showEyebrow": { "type": "boolean", "default": true },
		"showIntro": { "type": "boolean", "default": true },
		"eyebrow": { "type": "string", "role": "content", "default": "Pricing" },
		"title": { "type": "string", "role": "content", "default": "Simple plans, no surprises" },
		"intro": { "type": "string", "role": "content", "default": "Pay monthly or save with a yearly plan. Change or cancel whenever you want." },
		"headerAlign": { "type": "string", "default": "center" },
		"titleLevel": { "type": "number", "default": 2 },
		"columnsDesktop": { "type": "number", "default": 3 },
		"columnsTablet": { "type": "number", "default": 2 },
		"columnsMobile": { "type": "number", "default": 1 },
		"gap": { "type": "number", "default": 24 },
		"showToggle": { "type": "boolean", "default": true },
		"defaultPeriod": { "type": "string", "default": "monthly", "enum": [ "monthly", "yearly" ] },
		"monthlyLabel": { "type": "string", "role": "content", "default": "Monthly" },
		"yearlyLabel": { "type": "string", "role": "content", "default": "Yearly" },
		"yearlyNote": { "type": "string", "role": "content", "default": "Save 20%" },
		"showYearlyNote": { "type": "boolean", "default": true },
		"currency": { "type": "string", "default": "$" },
		"currencyPosition": { "type": "string", "default": "before", "enum": [ "before", "after" ] },
		"cardStyle": { "type": "string", "default": "bordered", "enum": [ "bordered", "filled", "shadow" ] },
		"contentAlign": { "type": "string", "default": "left", "enum": [ "left", "center" ] },
		"featuredScale": { "type": "boolean", "default": true },
		"buttonStyle": { "type": "string", "default": "auto", "enum": [ "auto", "fill", "outline" ] },
		"showPlanIcon": { "type": "boolean", "default": true },
		"showDescription": { "type": "boolean", "default": true },
		"showBadge": { "type": "boolean", "default": true },
		"showFeatures": { "type": "boolean", "default": true },
		"showExcluded": { "type": "boolean", "default": true },
		"showNote": { "type": "boolean", "default": true },
		"includedIcon": { "type": "object", "default": { "name": "check", "lib": "lucide", "anim": "draw", "trigger": "inview" } },
		"excludedIcon": { "type": "object", "default": { "name": "x", "lib": "lucide", "anim": "none", "trigger": "hover" } },
		"accentColor": { "type": "string" },
		"onAccentColor": { "type": "string" },
		"cardBg": { "type": "string" },
		"featuredBg": { "type": "string" },
		"cardBorderColor": { "type": "string" },
		"cardRadius": { "type": "number", "default": 18 },
		"iconSize": { "type": "number", "default": 18 },
		"iconStroke": { "type": "number", "default": 2.25 },
		"reveal": { "type": "boolean", "default": true }
	},
	"providesContext": {
		"werun-community/pricing/currency": "currency",
		"werun-community/pricing/currencyPosition": "currencyPosition",
		"werun-community/pricing/showToggle": "showToggle",
		"werun-community/pricing/defaultPeriod": "defaultPeriod",
		"werun-community/pricing/buttonStyle": "buttonStyle",
		"werun-community/pricing/showPlanIcon": "showPlanIcon",
		"werun-community/pricing/showDescription": "showDescription",
		"werun-community/pricing/showBadge": "showBadge",
		"werun-community/pricing/showFeatures": "showFeatures",
		"werun-community/pricing/showExcluded": "showExcluded",
		"werun-community/pricing/showNote": "showNote",
		"werun-community/pricing/includedIcon": "includedIcon",
		"werun-community/pricing/excludedIcon": "excludedIcon",
		"werun-community/pricing/reveal": "reveal",
		"werun-community/pricing/showHeader": "showHeader",
		"werun-community/pricing/title": "title",
		"werun-community/pricing/titleLevel": "titleLevel",
		"werun-community/pricing/cardStyle": "cardStyle",
		"werun-community/pricing/cardBg": "cardBg",
		"werun-community/pricing/featuredBg": "featuredBg",
		"werun-community/pricing/accentColor": "accentColor",
		"werun-community/pricing/onAccentColor": "onAccentColor",
		"werun-community/pricing/textColor": "textColor",
		"werun-community/pricing/style": "style"
	},
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"html": false,
		"color": { "background": true, "text": true, "gradients": true, "link": true },
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": [ "wrbc-shared", "file:./style-index.css" ],
	"viewScript": [ "wrbc-shared-view", "file:./view.js" ],
	"render": "file:./render.php"
}
