{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "werun-community/notice",
	"version": "1.0.0",
	"title": "Notice",
	"category": "werun-community",
	"icon": "info-outline",
	"description": "An info, success, warning or announcement message: inside the content or as a full-width bar (sticky at the top or bottom of the window), with a link, a close button that remembers, and dates to show it from and until.",
	"keywords": [ "notice", "alert", "banner", "announcement", "bar", "message", "callout" ],
	"textdomain": "werun-blocks-community",
	"attributes": {
		"tone": { "type": "string", "default": "info", "enum": [ "info", "success", "warning", "danger", "neutral", "brand" ] },
		"appearance": { "type": "string", "default": "soft", "enum": [ "soft", "solid" ] },
		"icon": { "type": "object" },
		"title": { "type": "string", "role": "content", "default": "Good to know" },
		"titleTag": { "type": "string", "role": "content", "default": "p", "enum": [ "p", "h2", "h3", "h4", "h5", "h6" ] },
		"message": { "type": "string", "role": "content", "default": "Orders placed before 2 pm ship the same day." },
		"showLink": { "type": "boolean", "default": false },
		"linkLabel": { "type": "string", "role": "content", "default": "Learn more" },
		"linkUrl": { "type": "string", "role": "content", "default": "" },
		"linkNewTab": { "type": "boolean", "default": false },
		"linkStyle": { "type": "string", "default": "link", "enum": [ "link", "button" ] },
		"layout": { "type": "string", "default": "inline", "enum": [ "inline", "bar" ] },
		"barPosition": { "type": "string", "default": "top", "enum": [ "top", "sticky-top", "sticky-bottom" ] },
		"stickyOffset": { "type": "number", "default": 0 },
		"contentAlign": { "type": "string", "default": "left", "enum": [ "left", "center" ] },
		"dismissible": { "type": "boolean", "default": false },
		"rememberDays": { "type": "number", "default": 7 },
		"closeIcon": { "type": "object", "default": { "name": "x", "lib": "lucide", "anim": "none", "trigger": "hover" } },
		"noticeId": { "type": "string", "role": "content", "default": "" },
		"schedule": { "type": "boolean", "role": "content", "default": false },
		"scheduleStart": { "type": "string", "role": "content", "default": "" },
		"scheduleEnd": { "type": "string", "role": "content", "default": "" },
		"urgent": { "type": "boolean", "default": false },
		"toneColor": { "type": "string" },
		"onToneColor": { "type": "string" },
		"iconSize": { "type": "number", "default": 20 },
		"radius": { "type": "number", "default": 12 }
	},
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"html": false,
		"color": { "background": true, "text": true, "link": true },
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": [ "wrbc-shared", "file:./style-index.css" ],
	"viewScript": [ "wrbc-shared-view", "file:./view.js" ],
	"render": "file:./render.php"
}
