{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "werun-community/feature",
	"version": "1.0.0",
	"title": "Feature card",
	"category": "werun-community",
	"icon": "id",
	"description": "One card of a feature grid.",
	"parent": [ "werun-community/features" ],
	"textdomain": "werun-blocks-community",
	"attributes": {
		"icon": { "type": "object", "role": "content", "default": { "name": "zap", "lib": "animated", "anim": "auto", "trigger": "hover" } },
		"title": { "type": "string", "role": "content", "default": "" },
		"text": { "type": "string", "role": "content", "default": "" },
		"badge": { "type": "string", "role": "content", "default": "" },
		"linkLabel": { "type": "string", "role": "content", "default": "Learn more" },
		"linkUrl": { "type": "string", "role": "content", "default": "" },
		"linkNewTab": { "type": "boolean", "default": false },
		"hideIcon": { "type": "boolean", "default": false },
		"hideText": { "type": "boolean", "default": false },
		"hideLink": { "type": "boolean", "default": false },
		"highlight": { "type": "boolean", "default": false }
	},
	"usesContext": [
		"werun-community/features/showHeader",
		"werun-community/features/title",
		"werun-community/features/titleLevel",
		"werun-community/features/showIcon",
		"werun-community/features/showTitle",
		"werun-community/features/showText",
		"werun-community/features/showLink",
		"werun-community/features/showBadge",
		"werun-community/features/linkStyle",
		"werun-community/features/iconStyle",
		"werun-community/features/itemTitleLevel",
		"werun-community/features/reveal",
		"werun-community/features/cardStyle",
		"werun-community/features/cardBg",
		"werun-community/features/accentColor",
		"werun-community/features/textColor",
		"werun-community/features/style",
		"werun-community/features/iconColor",
		"werun-community/features/iconBg"
	],
	"supports": {
		"anchor": true,
		"html": false,
		"reusable": false,
		"color": { "background": true, "text": true, "link": true },
		"spacing": { "padding": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
