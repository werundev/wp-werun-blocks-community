{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "werun-community/accordion",
	"version": "1.0.0",
	"title": "Accordion / FAQ",
	"category": "werun-community",
	"icon": "list-view",
	"description": "Questions that open and close, built on native details/summary so they work without JavaScript. One or several open, search, expand all, links to a question, FAQ schema, one or two columns.",
	"keywords": [ "accordion", "faq", "questions", "toggle", "collapse", "details" ],
	"textdomain": "werun-blocks-community",
	"allowedBlocks": [ "werun-community/accordion-item" ],
	"attributes": {
		"align": { "type": "string", "default": "wide" },
		"showHeader": { "type": "boolean", "default": true },
		"showEyebrow": { "type": "boolean", "default": true },
		"showIntro": { "type": "boolean", "default": true },
		"eyebrow": { "type": "string", "role": "content", "default": "FAQ" },
		"title": { "type": "string", "role": "content", "default": "Questions people ask before they start" },
		"intro": { "type": "string", "role": "content", "default": "Can't find yours? Write to us and we answer the same day." },
		"headerAlign": { "type": "string", "default": "left" },
		"titleLevel": { "type": "number", "default": 2 },
		"allowMultiple": { "type": "boolean", "default": false },
		"firstOpen": { "type": "boolean", "default": true },
		"accordionStyle": { "type": "string", "default": "separated", "enum": [ "separated", "boxed", "minimal" ] },
		"columns": { "type": "number", "default": 1 },
		"gap": { "type": "number", "default": 12 },
		"iconType": { "type": "string", "default": "chevron", "enum": [ "chevron", "plus", "custom", "none" ] },
		"iconClosed": { "type": "object", "default": { "name": "plus", "lib": "lucide", "anim": "none", "trigger": "hover" } },
		"iconOpen": { "type": "object", "default": { "name": "minus", "lib": "lucide", "anim": "none", "trigger": "hover" } },
		"iconPosition": { "type": "string", "default": "right", "enum": [ "right", "left" ] },
		"showItemIcons": { "type": "boolean", "default": false },
		"itemIcon": { "type": "object", "default": { "name": "circle-question-mark", "lib": "lucide", "anim": "none", "trigger": "hover" } },
		"showSearch": { "type": "boolean", "default": false },
		"searchPlaceholder": { "type": "string", "role": "content", "default": "Search the questions" },
		"noResults": { "type": "string", "role": "content", "default": "No question matches that search." },
		"showExpandAll": { "type": "boolean", "default": false },
		"faqSchema": { "type": "boolean", "default": false },
		"questionHeading": { "type": "string", "default": "auto", "enum": [ "auto", "none", "h2", "h3", "h4", "h5", "h6" ] },
		"accentColor": { "type": "string" },
		"itemBg": { "type": "string" },
		"itemBorderColor": { "type": "string" },
		"radius": { "type": "number", "default": 12 },
		"iconSize": { "type": "number", "default": 20 },
		"iconStroke": { "type": "number", "default": 2 }
	},
	"providesContext": {
		"werun-community/accordion/iconType": "iconType",
		"werun-community/accordion/iconClosed": "iconClosed",
		"werun-community/accordion/iconOpen": "iconOpen",
		"werun-community/accordion/iconPosition": "iconPosition",
		"werun-community/accordion/showItemIcons": "showItemIcons",
		"werun-community/accordion/itemIcon": "itemIcon",
		"werun-community/accordion/allowMultiple": "allowMultiple",
		"werun-community/accordion/questionHeading": "questionHeading",
		"werun-community/accordion/showHeader": "showHeader",
		"werun-community/accordion/title": "title",
		"werun-community/accordion/titleLevel": "titleLevel",
		"werun-community/accordion/columns": "columns",
		"werun-community/accordion/accordionStyle": "accordionStyle",
		"werun-community/accordion/itemBg": "itemBg",
		"werun-community/accordion/accentColor": "accentColor"
	},
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"html": false,
		"color": { "background": true, "text": true, "gradients": true, "link": true },
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": [ "wrbc-shared", "file:./style-index.css" ],
	"viewScript": [ "wrbc-shared-view", "file:./view.js" ],
	"render": "file:./render.php"
}
