	{
		"id": "mod-filter-chips",
		"title": "wrbc-filter markup bar (search, select, chips; one pressed) in a root without tone class: the tick carries the pressed state",
		"markup": "<!-- wp:werun-community/jobs {\"provider\":\"greenhouse\",\"board\":\"acme\",\"layout\":\"list\",\"groupBy\":false,\"maxJobs\":2} /-->\n<!-- wp:html -->\n<div class=\"wrbc-root wrbc-filter-demo\" data-wrbc-filter='{\"live\":\"%d results\",\"liveOne\":\"1 result\"}'><div class=\"wrbc-filter__bar\" role=\"search\" aria-label=\"Filter the list\"><label for=\"mfc-q\">Search</label><input id=\"mfc-q\" class=\"wrbc-filter__search\" type=\"search\" data-wrbc-filter-search placeholder=\"Type to filter\"><label for=\"mfc-s\">Kind</label><select id=\"mfc-s\" class=\"wrbc-filter__select\" data-wrbc-filter-select=\"kind\"><option value=\"\">All kinds</option><option value=\"a\">A</option><option value=\"b\">B</option></select><ul class=\"wrbc-filter__chips\"><li><button type=\"button\" class=\"wrbc-filter__chip\" data-wrbc-filter-chip=\"tone\" data-value=\"warm\" aria-pressed=\"true\">Warm</button></li><li><button type=\"button\" class=\"wrbc-filter__chip\" data-wrbc-filter-chip=\"tone\" data-value=\"cool\" aria-pressed=\"false\">Cool</button></li></ul></div><ul><li data-wrbc-filter-item data-kind=\"a\" data-tone=\"warm\">Alpha</li><li data-wrbc-filter-item data-kind=\"b\" data-tone=\"cool\">Beta</li><li data-wrbc-filter-item data-kind=\"a\" data-tone=\"warm\">Gamma</li></ul><p class=\"wrbc-filter__empty\" data-wrbc-filter-empty hidden>Nothing matches.</p><p class=\"wrbc-sr-only\" data-wrbc-filter-status aria-live=\"polite\"></p></div>\n<!-- /wp:html -->",
		"nonText": [
			{
				"selector": ".wrbc-filter__chip[aria-pressed=\"true\"]",
				"property": "color",
				"against": "self:background-color",
				"min": 3,
				"label": "pressed chip: tick (drawn in the text colour) on its fill"
			},
			{
				"selector": ".wrbc-filter__chip[aria-pressed=\"false\"]",
				"property": "border-top-color",
				"min": 3,
				"label": "chip boundary"
			}
		]
	},
