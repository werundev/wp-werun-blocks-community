	{
		"id": "mod-carousel-text",
		"title": "Carousel block: text-only slides, 2 per view, autoplay, dots + arrows (track Tab stop, play/pause, dots)",
		"markup": "<!-- wp:werun-community/carousel {\"columnsDesktop\":2,\"columnsTablet\":2,\"autoplay\":true,\"interval\":4} -->\n<!-- wp:werun-community/slide -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Alpha</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Only text in this slide.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:werun-community/slide -->\n<!-- wp:werun-community/slide -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Beta</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Only text in this slide.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:werun-community/slide -->\n<!-- wp:werun-community/slide -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Gamma</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Only text in this slide.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:werun-community/slide -->\n<!-- wp:werun-community/slide -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Delta</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Only text in this slide.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:werun-community/slide -->\n<!-- wp:werun-community/slide -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Epsilon</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Only text in this slide.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:werun-community/slide -->\n<!-- /wp:werun-community/carousel -->",
		"nonText": [
			{
				"selector": ".wrbc-carousel__dot:not([aria-current=\"true\"])",
				"pseudo": "::before",
