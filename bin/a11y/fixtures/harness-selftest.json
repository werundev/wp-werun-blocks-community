			"axe:color-contrast"
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\"} -->\n<!-- wp:html -->\n<p style=\"color:#aaaaaa\">Low contrast text #aaa on white.</p>\n<div style=\"height:1400px\"></div>\n<p><a href=\"#st-cov\" class=\"st-covered\">Covered link</a></p>\n<div style=\"height:40px\"></div>\n<div class=\"st-bar\" style=\"position:fixed;left:0;right:0;bottom:0;height:160px;background:#000;color:#fff;z-index:9999\">Fixed bar</div>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
	{
		"id": "st-image",
		"title": "Self-test: white text straight on a light image (review: worst 1:1) and on a 70% overlay (resolved)",
		"contexts": [
			"light"
		],
		"expect": [
			"axe-review:color-contrast"
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\"} -->\n<!-- wp:html -->\n<div style=\"position:relative;isolation:isolate\"><img src=\"{{url:bg-light}}\" alt=\"\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1\"><p class=\"st-on-image\" style=\"color:#fff;margin:0;padding:40px\">White text on a light image, no overlay.</p></div>\n<div style=\"position:relative;isolation:isolate;margin-top:16px\"><img src=\"{{url:bg-light}}\" alt=\"\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2\"><span style=\"position:absolute;inset:0;background:#000;opacity:.7;z-index:-1\"></span><p class=\"st-on-overlay\" style=\"color:#fff;margin:0;padding:40px\">White text over a 70% black overlay.</p></div>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
	{
		"id": "st-pseudo",
		"title": "Self-test: step numbers drawn with ::before counters (#bbb fails), a ::after badge on its own fill (passes)",
		"contexts": [
			"light",
			"dark"
		],
		"widths": [
			1280
		],
		"expect": [
			"pseudo:pseudo-text-contrast"
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\"} -->\n<!-- wp:html -->\n<ol class=\"st-steps\" style=\"list-style:none;padding:0;counter-reset:st\"><li>Plan</li><li>Build</li></ol>\n<p class=\"st-badge\">Release</p>\n<ul class=\"st-numbers\" style=\"list-style-type:decimal\"><li>Numbered by ::marker</li></ul>\n<style>.st-steps li{counter-increment:st}.st-steps li::before{content:counter(st) \". \";color:#bbbbbb;font-weight:700}.st-badge::after{content:\"New\";margin-left:8px;padding:2px 8px;border-radius:999px;background:#4f46e5;color:#ffffff;font-size:12px}</style>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
	{
		"id": "st-hidden-control",
		"title": "Self-test: visually hidden checkboxes whose focus ring is drawn on the label (good ring, low ring)",
		"contexts": [
			"light"
		],
		"widths": [
			1280
		],
		"expect": [
			"focus:focus-contrast"
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\"} -->\n<!-- wp:html -->\n<p><input type=\"checkbox\" id=\"st-c1\" class=\"st-vh\"><label for=\"st-c1\" class=\"st-opt st-good-ring\">Good ring on the label</label></p>\n<p><input type=\"checkbox\" id=\"st-c2\" class=\"st-vh\"><label for=\"st-c2\" class=\"st-opt st-low-ring\">Low ring on the label</label></p>\n<style>.st-vh{position:absolute;opacity:0;width:1px;height:1px;margin:0}.st-opt{display:inline-block;padding:8px 14px;border:1px solid #6b7280;border-radius:8px}.st-vh:focus-visible+.st-good-ring{outline:2px solid #111;outline-offset:2px}.st-vh:focus-visible+.st-low-ring{outline:2px solid #dddddd;outline-offset:2px}</style>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
