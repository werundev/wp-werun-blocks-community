[
	{
		"id": "st-focus",
		"title": "Self-test: focus indicators (none, low contrast, clipped) next to a good one",
		"contexts": [
			"light"
		],
		"expect": [
			"focus:focus-visible",
			"focus:focus-contrast"
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\"} -->\n<!-- wp:html -->\n<p><a href=\"#st-good\" class=\"st-good\">Good focus ring</a></p>\n<p><a href=\"#st-none\" class=\"st-nofocus\">No focus style</a></p>\n<p><a href=\"#st-low\" class=\"st-low\">Low contrast ring</a></p>\n<div style=\"overflow:hidden\"><a href=\"#st-clip\" class=\"st-clip\" style=\"display:block\">Ring clipped by overflow hidden</a></div>\n<p><a href=\"#st-under\" class=\"st-under\">Underline on focus only</a></p>\n<style>.st-good:focus-visible{outline:2px solid #111!important;outline-offset:2px!important}.st-nofocus:focus,.st-nofocus:focus-visible{outline:none!important}.st-low:focus-visible{outline:2px solid #c7d2fe!important;outline-offset:2px!important}.st-clip:focus-visible{outline:3px solid #000!important;outline-offset:2px!important}.st-under{text-decoration:none}.st-under:focus-visible{outline:none!important;text-decoration:underline;text-decoration-thickness:2px}</style>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
	{
		"id": "st-target",
		"title": "Self-test: 12 px targets side by side (fail) and one alone (spacing exception)",
		"contexts": [
			"light"
		],
		"widths": [
			1280
		],
		"expect": [
			"target:target-size"
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\"} -->\n<!-- wp:html -->\n<p><a href=\"#t1\" style=\"display:inline-block;width:12px;height:12px;background:#333\" aria-label=\"Dot one\"></a><a href=\"#t2\" style=\"display:inline-block;width:12px;height:12px;background:#333;margin-left:2px\" aria-label=\"Dot two\"></a></p>\n<p style=\"margin-top:60px\"><a href=\"#t3\" style=\"display:inline-block;width:12px;height:12px;background:#333;margin-left:120px\" aria-label=\"Lonely dot\"></a></p>\n<p>Inline <a href=\"#t4\">link</a> inside a sentence is exempt.</p>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
	{
		"id": "st-form",
		"title": "Self-test: input boundary 1.2:1 (fail), placeholder #c0c0c0 (fail), a good input",
		"contexts": [
			"light"
		],
		"expect": [
			"nontext:control-boundary",
			"nontext:placeholder-contrast"
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\"} -->\n<!-- wp:html -->\n<p><label for=\"st-in1\">Faint border</label> <input id=\"st-in1\" type=\"text\" style=\"border:1px solid #e5e7eb;background:#fff\"></p>\n<p><label for=\"st-in2\">Light placeholder</label> <input id=\"st-in2\" class=\"st-ph\" type=\"email\" placeholder=\"you@example.com\" style=\"border:1px solid #6b7280;background:#fff\"></p>\n<p><label for=\"st-in3\">Good field</label> <input id=\"st-in3\" type=\"text\" style=\"border:1px solid #6b7280;background:#fff\"></p>\n<style>.st-ph::placeholder{color:#c0c0c0;opacity:1}</style>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
	{
		"id": "st-motion",
		"title": "Self-test: an infinite spin and a 6 s one-shot slide, no reduced-motion rule (fail in both motion runs)",
		"contexts": [
			"light"
		],
		"expect": [
			"motion:animation-over-5s",
			"motion:reduced-motion-animation"
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\"} -->\n<!-- wp:html -->\n<p><span class=\"st-spin\" aria-hidden=\"true\">★</span> Spinning star</p>\n<p><span class=\"st-long\" aria-hidden=\"true\">▶</span> A six-second slide</p>\n<style>@keyframes st-spin{to{transform:rotate(360deg)}}.st-spin{display:inline-block;animation:st-spin 2s linear infinite}@keyframes st-slide{to{transform:translateX(200px)}}.st-long{display:inline-block;animation:st-slide 6s linear 1}</style>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
	{
		"id": "st-motion-late",
		"title": "Self-test: a 1.2 s animation that a script starts 5.5 s after load (short: must not be reported)",
		"contexts": [
			"light"
		],
		"widths": [
			1280
		],
		"expectNot": [
			"motion:animation-over-5s"
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\"} -->\n<!-- wp:html -->\n<p><span class=\"st-late\" aria-hidden=\"true\">●</span> Starts late, runs 1.2 s</p>\n<style>@keyframes st-pop{from{transform:scale(.4)}to{transform:scale(1)}}.st-late{display:inline-block}.st-late.go{animation:st-pop 1.2s ease 1}</style>\n<script>setTimeout(function(){var e=document.querySelector('.st-late');if(e){e.classList.add('go');}},5500);</script>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
	{
		"id": "st-carousel",
		"title": "Self-test: an autoplay query carousel (its root has no id): auto-advance found, with its own pause button",
		"contexts": [
			"light"
		],
		"widths": [
			1280
		],
		"expect": [
			"motion:auto-advance"
		],
		"expectNot": [
			"motion:autoplay-no-pause"
		],
		"markup": "<!-- wp:werun-community/query {\"variant\":\"posts\",\"layout\":\"carousel\",\"autoplay\":true,\"interval\":3,\"columnsDesktop\":2,\"query\":{\"postType\":\"post\",\"perPage\":6},\"card\":{\"style\":\"bordered\",\"link\":\"title\",\"fields\":[{\"type\":\"title\",\"level\":3},{\"type\":\"excerpt\",\"words\":10}]}} /-->"
	},
	{
		"id": "st-layout",
		"title": "Self-test: 600 px box (reflow), unreachable scroller, fixed-height clipped text (spacing)",
		"contexts": [
			"light"
		],
		"expect": [
			"reflow:reflow-overflow",
			"reflow:scroller-keyboard",
			"spacing:text-spacing-clip"
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\",\"innerWidth\":\"full\"} -->\n<!-- wp:html -->\n<div class=\"st-wide\" style=\"width:600px;background:#eee\">A fixed 600 px wide box.</div>\n<div class=\"st-scroller\" style=\"overflow-x:auto;white-space:nowrap;max-width:100%\"><span>A long line that only scrolls sideways and holds nothing focusable, so a keyboard user cannot scroll it at all.</span></div>\n<div class=\"st-fixed\" style=\"height:40px;overflow:hidden;line-height:1.2;font-size:16px;max-width:260px\">Two short lines of text in a box of fixed height.</div>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
	{
		"id": "st-clip-margin",
		"title": "Self-test: a scroller reaching 6 px into its parent's 12 px overflow-clip-margin (not clipped) next to text cut by overflow:hidden (clipped)",
		"contexts": [
			"light"
		],
		"widths": [
			1280
		],
		"expect": [
			"reflow:reflow-clipped"
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\"} -->\n<!-- wp:html -->\n<div class=\"st-clipm\" style=\"overflow-x:clip;overflow-clip-margin:12px;max-width:280px\"><div class=\"st-clipm-track\" style=\"margin-inline:-6px;padding:6px;overflow-x:auto;white-space:nowrap\" tabindex=\"0\" role=\"region\" aria-label=\"Scroller in a clip margin\"><span>Item one</span> <span>Item two</span> <span>Item three</span> <span>Item four</span> <span>Item five</span></div></div>\n<div class=\"st-clipped\" style=\"overflow:hidden;max-width:280px;margin-top:16px\"><p class=\"st-cut\" style=\"margin:0;white-space:nowrap\">This sentence is wider than its box and gets cut off at the edge.</p></div>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
	{
		"id": "st-slides",
		"title": "Self-test: amber stars on dark slides, two slides scrolled out of the track (measured where they show, not against the white page)",
		"contexts": [
			"light"
		],
		"widths": [
			375
		],
		"expectNot": [
			"nontext:fixture-rule"
		],
		"nonText": [
			{
				"selector": ".st-star",
				"property": "color",
				"min": 3,
				"label": "stars on dark slides"
			}
		],
		"markup": "<!-- wp:werun-community/section {\"paddingY\":\"sm\"} -->\n<!-- wp:html -->\n<div class=\"st-track\" style=\"display:flex;gap:12px;overflow-x:auto;width:300px;scroll-snap-type:x mandatory\" tabindex=\"0\" role=\"region\" aria-label=\"Slides\"><div class=\"st-slide\" style=\"flex:0 0 280px;background:#0f172a;color:#f8fafc;padding:16px;scroll-snap-align:start\"><span class=\"st-star\" style=\"color:#f59e0b\" role=\"img\" aria-label=\"5 stars\">★★★★★</span> Slide one</div><div class=\"st-slide\" style=\"flex:0 0 280px;background:#0f172a;color:#f8fafc;padding:16px;scroll-snap-align:start\"><span class=\"st-star\" style=\"color:#f59e0b\" role=\"img\" aria-label=\"4 stars\">★★★★</span> Slide two</div><div class=\"st-slide\" style=\"flex:0 0 280px;background:#0f172a;color:#f8fafc;padding:16px;scroll-snap-align:start\"><span class=\"st-star\" style=\"color:#f59e0b\" role=\"img\" aria-label=\"3 stars\">★★★</span> Slide three</div></div>\n<!-- /wp:html -->\n<!-- /wp:werun-community/section -->"
	},
	{
		"id": "st-obscured",
		"title": "Self-test: a fixed bar covers the focused link (2.4.11) and low-contrast text",
